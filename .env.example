DB_HOST=localhost
DB_PORT=5432
DB_NAME=mantenimiento
DB_USER=unh_mantenimiento
DB_PASSWORD=cambia-esto

# Supabase: en vez de DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD, define
# DB_URL con la URL completa del pooler y las credenciales del proyecto.
# El usuario del pooler SIEMPRE lleva el prefijo 'postgres.' (el project ref).
# IMPORTANTE: la linea se deja COMENTADA. Si se deja escrita y vacia, Spring
# la toma como el valor de DB_URL (una cadena vacia) y la conexion falla.
#   DB_URL=jdbc:postgresql://aws-1-us-west-1.pooler.supabase.com:5432/postgres
#   DB_USER=postgres.nvfbppvseevfiagqmtgb
#   DB_PASSWORD=<la contrasena del proyecto>
# DB_SCHEMA: esquema donde viven las tablas (por defecto 'public').
# DB_SCHEMA=public

JWT_SECRET=cambia-esto-por-una-clave-larga-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRACION_MINUTOS=120

EVIDENCIAS_DIR=/home/tu-usuario/evidencias
